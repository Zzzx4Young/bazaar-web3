{
  "name": "bazaar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:backend": "npm run build && npm run typecheck && npm run lint && node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "db:psql": "node scripts/local-psql.mjs",
    "db:observer:grant": "node --env-file-if-exists=.tmp/i7-migrate.env scripts/apply-observer-grants.mjs",
    "db:observer:setup": "node scripts/setup-local-observer.mjs --confirm-local-create",
    "seed:v2": "npm run build && node --env-file-if-exists=.tmp/i7-migrate.env scripts/v2-seed.mjs",
    "test:deployment": "npm run build && node scripts/with-test-db.mjs node scripts/check-deployment-images.mjs",
    "test:backup-restore": "npm run build && node scripts/with-backup-restore.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:db": "npm run build && node --test --test-concurrency=1 tests/*.integration.mjs",
    "test:capacity": "npm run build && node scripts/with-test-db.mjs node scripts/check-capacity.mjs",
    "test:capacity:failover": "npm run build && CAPACITY_FAULT=1 node scripts/with-test-db.mjs node scripts/check-capacity.mjs",
    "test:postgres-ha": "npm run build && node scripts/check-postgres-ha.mjs",
    "test:postgres-ha:auto": "npm run build && node scripts/check-postgres-ha-auto.mjs",
    "test:postgres-ha:freeze": "npm run build && node scripts/check-postgres-ha-auto.mjs --process-freeze",
    "test:postgres-ha:gateway": "npm run build && node scripts/check-postgres-ha-auto.mjs --gateway-failure",
    "test:postgres-ha:http": "npm run build && node scripts/check-postgres-ha-auto.mjs --http-ingress",
    "test:watchdog:required": "node scripts/check-watchdog-required.mjs",
    "test:http-ingress:transport": "node scripts/check-http-ingress.mjs",
    "test:http-ingress:business": "npm run build && node scripts/with-test-db.mjs node scripts/check-http-ingress-business.mjs",
    "test:capacity:ha": "npm run build && node scripts/check-postgres-ha-auto.mjs --capacity",
    "test:capacity:writes": "npm run build && CAPACITY_WRITES=1 node scripts/with-test-db.mjs node scripts/check-capacity.mjs",
    "test:capacity:writes:failover": "npm run build && CAPACITY_WRITES=1 CAPACITY_FAULT=1 node scripts/with-test-db.mjs node scripts/check-capacity.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
