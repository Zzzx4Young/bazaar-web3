# Supply the local password; never commit the populated .env file.
DATABASE_URL=postgresql://bazaar_runtime:REPLACE_ME@127.0.0.1:5432/bazaar_dev?schema=bazaar
# Deployment alternative: set DATABASE_URL_FILE instead of DATABASE_URL.
# DATABASE_URL_FILE=/run/secrets/runtime_database_url
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3000
# Optional, only after the ingress sanitizes forwarding headers and origin access is restricted.
# TRUSTED_PROXY_CIDRS=10.20.0.2/32,10.20.0.3/32
# Per API instance; budget across all replicas against PostgreSQL max_connections.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=3000
# Accepted in-flight work per API; excess requests receive retryable 503.
API_MAX_IN_FLIGHT=200
