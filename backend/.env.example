# Supply the local password; never commit the populated .env file.
DATABASE_URL=postgresql://bazaar_runtime:REPLACE_ME@127.0.0.1:5432/bazaar_dev?schema=bazaar
# Deployment alternative: set DATABASE_URL_FILE instead of DATABASE_URL.
# DATABASE_URL_FILE=/run/secrets/runtime_database_url
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3000
# Optional Google web OAuth client. Register the exact redirect URI
# http://localhost:3000/api/auth/google/callback for this APP_ORIGIN.
# GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET_FILE=/absolute/path/to/google_client_secret
# Dev-only alternative to the secret file: GOOGLE_CLIENT_SECRET=REPLACE_ME
# Email-code endpoints remain unavailable until a real EmailSender is wired.
# EMAIL_CODE_HMAC_KEY_FILE=/absolute/path/to/email_code_hmac_key
# Optional, only after the ingress sanitizes forwarding headers and origin access is restricted.
# TRUSTED_PROXY_CIDRS=10.20.0.2/32,10.20.0.3/32
# Per API instance; budget across all replicas against PostgreSQL max_connections.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=3000
# Accepted in-flight work per API; excess requests receive retryable 503.
API_MAX_IN_FLIGHT=200

# Optional testnet-only payment signing file; absent by default. Never commit its contents.
# WEB3_PAYMENT_SIGNER_FILE=/absolute/protected/path/payment-signer.json
# Replacement/release requires T07 pinned deployment and complete active finalized projection.
# Optional isolated Web3 private files; unset by default. Never reuse image bucket credentials.
# PRIVATE_FILE_CONFIG_FILE=/absolute/protected/path/isolated-private-file-config.json

# T07: required for real payment signing; pinned block/code/role JSON, never RPC keys.
# WEB3_CHAIN_DEPLOYMENT_FILE=/absolute/protected/path/chain-deployment.json

# T08: independent protected JSON {key,keyId}; never reuse the payment key.
# WEB3_DELIVERY_SIGNER_FILE=/absolute/protected/delivery-signer.json

# T10: REQUIRED by non-injected Web3 API/indexer; independently protected storage,
# outside ALL database/backup restore paths. Fresh empty-ledger provisioning only.
# WEB3_SECURITY_WITNESS_DIR=/absolute/protected/witness-volume/ledger

# T10 private lifecycle: separate append-only database + independent witness root.
# API uses restricted SELECT/INSERT credentials; maintenance uses owner credentials.
# JSON: {"urlFile":"/absolute/protected/private-ledger-runtime-url", "ledgerId":"UUID", "witnessDirectory":"/absolute/independent/private-witness"}
# PRIVATE_LIFECYCLE_CONFIG_FILE=/absolute/protected/private-lifecycle.json
# Maintenance only (not required by ordinary Alpha startup):
# PRIVATE_BACKUP_DATABASE_URL_FILE=/absolute/protected/business-backup-owner-url
# PRIVATE_BACKUP_KEY_FILE=/absolute/protected/32-byte-key-as-64-hex
# PRIVATE_BACKUP_DIRECTORY=/absolute/protected/backup-volume
# PRIVATE_RESTORE_DATABASE_URL_FILE=/absolute/protected/fresh-restore-owner-url
# PRIVATE_RESTORE_FILE_CONFIG_FILE=/absolute/protected/separate-restore-file-config.json
# WEB3_SECURITY_LEDGER_OWNER_URL_FILE=/absolute/protected/security-owner-url
# Provisioning only: PRIVATE_LEDGER_OWNER_URL_FILE, PRIVATE_LEDGER_ID,
# PRIVATE_LEDGER_WITNESS_DIR and PRIVATE_LEDGER_RUNTIME_ROLE.

# T10 controlled recovery: freeze these bootstrap paths outside application backups.
# Verification key/checkpoint/history/config descriptors belong to another OS account;
# the API/indexer UID must be unable to modify files OR replace parent entries.
# WEB3_RECOVERY_PROFILE=controlled
# WEB3_SECURITY_CHECKPOINT_CONFIG_FILE=/absolute/custodian-public/wallet-current.config
# Descriptor JSON: {"environmentId":"ENV_ID","checkpointFile":"/absolute/C2.json",
#   "historyFile":"/absolute/C2.history","publicKeyFile":"/absolute/pinned-public.pem"}
# PRIVATE_LIFECYCLE_CONFIG_FILE JSON additionally supplies checkpointConfigFile
# for the corresponding private-files descriptor. Missing either side fails closed.
# Recovery authority private/wrapping keys are NEVER configured on the website.

# Wallet descriptor also pins pairedPrivateConfigurationFile to the exact private descriptor.
