// C1 order core. Authentication and currency-specific contracts are finalized in C2.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                   String              @id @default(uuid()) @db.Uuid
  loginName            String              @unique @db.VarChar(100)
  displayName          String
  status               String              @default("active")
  role                 String              @default("participant")
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  listingSellerRows    Listing[]           @relation("listingSeller")
  orderBuyerRows       Order[]             @relation("orderBuyer")
  eventActorRows       OrderEvent[]        @relation("eventActor")
  idempotencyActorRows IdempotencyRecord[] @relation("idempotencyActor")
  resolvedRefundRows   RefundRequest[]     @relation("refundResolver")
  reviewBuyerRows      SellerReview[]      @relation("reviewBuyer")
  reviewSellerRows     SellerReview[]      @relation("reviewSeller")
  checkoutBuyerRows    Checkout[]          @relation("checkoutBuyer")
  mediaSellerRows      MediaAsset[]        @relation("mediaSeller")
  listingReviewRows    ListingReviewEvent[]
  credential           AccountCredential?
  sessions             Session[]
  identities           AccountIdentity[]
  identityEvents        AccountIdentityEvent[]
  gmailClaims          GmailClaim[]
  googleAttempts       GoogleOAuthAttempt[]
  walletIdentities     WalletIdentity[]
  walletClaims         WalletClaim[]
  walletChallenges     WalletChallenge[]
  walletOperations     WalletSecurityOperation[]
  walletEvents         WalletIdentityEvent[]
  payoutConfirmations  SellerPayoutConfirmation[]
}

model AccountIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  provider  String   @db.VarChar(16)
  subject   String   @db.VarChar(100)
  email     String   @db.VarChar(100)
  verifiedAt DateTime? @db.Timestamptz(6)
  verificationSource String? @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, subject])
  @@unique([accountId, provider])
}

model AccountIdentityEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @db.Uuid
  provider           String   @db.VarChar(16)
  action             String   @db.VarChar(16)
  previousSubject    String?  @db.VarChar(100)
  currentSubject     String   @db.VarChar(100)
  previousEmail      String?  @db.VarChar(100)
  currentEmail       String   @db.VarChar(100)
  verificationSource String   @db.VarChar(24)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, createdAt])
}

model GmailClaim {
  key       String   @id @db.VarChar(100)
  accountId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId])
}

model EmailCodeChallenge {
  key        String    @id @db.Char(64)
  id         String    @default(uuid()) @db.Uuid
  email      String    @db.VarChar(100)
  purpose    String    @db.VarChar(16)
  accountId  String?   @db.Uuid
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)

  @@index([expiresAt])
}

model GoogleOAuthAttempt {
  stateHash  String    @id @db.Char(64)
  cookieHash String    @db.Char(64)
  verifier   String    @db.VarChar(128)
  nonce      String    @db.VarChar(128)
  returnTo   String    @db.VarChar(255)
  mode       String    @db.VarChar(16)
  accountId  String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
}

model AccountCredential {
  accountId    String   @id @db.Uuid
  passwordHash String
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model Session {
  tokenHash String    @id @db.Char(64)
  accountId String    @db.Uuid
  authMethod String?   @db.VarChar(24)
  walletChainId Int?
  walletAddress String? @db.VarChar(42)
  walletBindingVersion Int?
  recoveryEpoch String? @db.Uuid
  authenticatedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId])
  @@index([expiresAt])
}

model AuthRateBucket {
  key       String   @id @db.Char(64)
  count     Int
  windowEnd DateTime @db.Timestamptz(6)

  @@index([windowEnd])
}

model RateSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  rates     Json
  fetchedAt DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model Listing {
  id                   String              @id @default(uuid()) @db.Uuid
  sellerId             String              @db.Uuid
  type                 String
  saleMode             String              @default("one_off")
  title                String
  description          String
  category             String
  priceAmount          Decimal             @db.Decimal(38, 18)
  currency             String              @db.VarChar(12)
  publicationStatus    String              @default("published")
  version              Int                 @default(1)
  licenseDescription   String?
  contentVersion       String?
  commitment           Json?
  commitmentVersion    Int?
  replacementOfListingId String?           @unique @db.Uuid
  reviewStatus         String              @default("clear")
  reviewPending        Boolean             @default(false)
  reviewReason         String?
  reviewKind           String?
  reviewUpdatedAt      DateTime?           @db.Timestamptz(6)
  testnetPrices        ListingTestnetPrice[]
  reviewRows           ListingReviewEvent[]
  replacesListing      Listing?            @relation("listingReplacement", fields: [replacementOfListingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacementRows      Listing[]           @relation("listingReplacement")
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  listingSeller        Account             @relation("listingSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderListingRows     Order[]             @relation("orderListing")
  inventoryListingRows PhysicalInventory[] @relation("inventoryListing")
  digitalInventoryRows DigitalInventory[]  @relation("digitalInventoryListing")
  mediaRows            ListingMedia[]

  @@unique([id, sellerId])
  @@unique([id, type])
  @@index([publicationStatus, createdAt, id])
  @@index([publicationStatus, type, createdAt, id])
  @@index([sellerId, createdAt, id])
}

model MediaAsset {
  id               String         @id @default(uuid()) @db.Uuid
  sellerId         String         @db.Uuid
  uploadKey        String         @unique
  hotKey           String?        @unique
  coldKey          String?        @unique
  status           String         @default("pending")
  contentType      String
  declaredBytes    Int
  actualBytes      Int?
  sha256           String?        @db.Char(64)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  verifiedAt       DateTime?      @db.Timestamptz(6)
  seller           Account        @relation("mediaSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  listingRows      ListingMedia[]
  orderRows        OrderMediaSnapshot[]

  @@index([sellerId, status, createdAt])
}

model ListingMedia {
  listingId String     @db.Uuid
  mediaId   String     @unique @db.Uuid
  position  Int
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([listingId, mediaId])
  @@unique([listingId, position])
  @@index([mediaId])
}

model Order {
  id                        String                 @id @default(uuid()) @db.Uuid
  listingId                 String                 @db.Uuid
  buyerId                   String                 @db.Uuid
  sellerId                  String                 @db.Uuid
  checkoutId                String?                @db.Uuid
  testnetSnapshot           TestnetOrderSnapshot?
  settlementMode            String                 @default("simulated")
  status                    String                 @default("pending_payment")
  version                   Int                    @default(1)
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @db.Timestamptz(6)
  completedAt               DateTime?              @db.Timestamptz(6)
  transactionPausedAt       DateTime?              @db.Timestamptz(6)
  pauseReviewId             String?                @db.Uuid
  orderListing              Listing                @relation("orderListing", fields: [listingId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  orderBuyer                Account                @relation("orderBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshot                  OrderSnapshot?         @relation("snapshotOrder")
  mediaRows                 OrderMediaSnapshot[]
  shipping                  OrderShipping?         @relation("shippingOrder")
  inventoryOrderRows        PhysicalInventory[]    @relation("inventoryOrder")
  digitalInventoryOrderRows DigitalInventory[]     @relation("digitalInventoryOrder")
  reservationOrderRows      InventoryReservation[] @relation("reservationOrder")
  deliveryOrderRows         DeliveryRecord[]       @relation("deliveryOrder")
  issueOrderRows            IssueRecord[]          @relation("issueOrder")
  eventOrderRows            OrderEvent[]           @relation("eventOrder")
  idempotencyOrderRows      IdempotencyRecord[]    @relation("idempotencyOrder")

  refundBuyerRows  RefundRequest[] @relation("refundBuyer")
  refundSellerRows RefundRequest[] @relation("refundSeller")
  review             SellerReview?
  checkout           Checkout? @relation(fields: [checkoutId, buyerId], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, buyerId])
  @@unique([id, sellerId])
  @@unique([id, listingId])
  @@unique([id, listingId, sellerId], map: "Order_testnet_listing_seller_key")
  @@index([buyerId, createdAt, id])
  @@index([sellerId, createdAt, id])
  @@index([listingId])
  @@index([status, createdAt, id])
  @@index([completedAt, id])
  @@index([checkoutId])
}

model OrderMediaSnapshot {
  orderId     String     @db.Uuid
  mediaId     String     @db.Uuid
  position    Int
  storageTier String     @default("hot")
  archivedAt  DateTime?  @db.Timestamptz(6)
  archiveClaimToken String? @db.Uuid
  archiveClaimedUntil DateTime? @db.Timestamptz(6)
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([orderId, mediaId])
  @@unique([orderId, position])
  @@index([storageTier, orderId])
  @@index([mediaId, storageTier])
}

model Checkout {
  id              String    @id @default(uuid()) @db.Uuid
  buyerId         String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  checkoutBuyer   Account   @relation("checkoutBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orders          Order[]

  @@unique([id, buyerId])
  @@index([buyerId, createdAt])
}

model OrderSnapshot {
  testnetSnapshot         TestnetOrderSnapshot?
  orderId                String             @id @db.Uuid
  listingVersion         Int
  title                  String
  description            String
  type                   String
  category               String
  priceAmount            Decimal            @db.Decimal(38, 18)
  currency               String             @db.VarChar(12)
  licenseDescription     String?
  contentVersion         String?
  commitment             Json?
  commitmentVersion      Int?
  snapshotOrder          Order              @relation("snapshotOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settlementSnapshotRows SettlementRecord[] @relation("settlementSnapshot")

  @@unique([orderId, priceAmount, currency])
  @@unique([orderId, listingVersion])
}

model OrderShipping {
  orderId       String @id @db.Uuid
  recipient     String
  contact       String
  address       String
  shippingOrder Order  @relation("shippingOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model PhysicalInventory {
  listingId                String                 @id @db.Uuid
  listingType              String                 @default("physical")
  availability             String                 @default("available")
  activeOrderId            String?                @db.Uuid
  version                  Int                    @default(1)
  inventoryListing         Listing                @relation("inventoryListing", fields: [listingId, listingType], references: [id, type], onDelete: Restrict, onUpdate: Restrict)
  inventoryOrder           Order?                 @relation("inventoryOrder", fields: [activeOrderId, listingId], references: [id, listingId], onDelete: Restrict, onUpdate: Restrict)
  reservationInventoryRows InventoryReservation[] @relation("reservationInventory")
}

model DigitalInventory {
  listingId        String  @id @db.Uuid
  listingType      String  @default("digital")
  availability     String  @default("available")
  activeOrderId    String? @db.Uuid
  version          Int     @default(1)
  inventoryListing Listing @relation("digitalInventoryListing", fields: [listingId, listingType], references: [id, type], onDelete: Restrict, onUpdate: Restrict)
  inventoryOrder   Order?  @relation("digitalInventoryOrder", fields: [activeOrderId, listingId], references: [id, listingId], onDelete: Restrict, onUpdate: Restrict)
}

model InventoryReservation {
  id                   String            @id @default(uuid()) @db.Uuid
  listingId            String            @db.Uuid
  orderId              String            @unique @db.Uuid
  state                String            @default("active")
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  closedAt             DateTime?         @db.Timestamptz(6)
  reservationInventory PhysicalInventory @relation("reservationInventory", fields: [listingId], references: [listingId], onDelete: Restrict, onUpdate: Restrict)
  reservationOrder     Order             @relation("reservationOrder", fields: [orderId, listingId], references: [id, listingId], onDelete: Restrict, onUpdate: Restrict)
}

model DeliveryRecord {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  sellerId      String   @db.Uuid
  sequence      Int
  kind          String
  reference     String
  carrier       String?
  accessCode    String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  deliveryOrder Order    @relation("deliveryOrder", fields: [orderId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, sequence])
}

model IssueRecord {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @db.Uuid
  buyerId         String          @db.Uuid
  sourceStatus    String
  description     String
  status          String          @default("open")
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?       @db.Timestamptz(6)
  issueOrder      Order           @relation("issueOrder", fields: [orderId, buyerId], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  refundIssueRows RefundRequest[] @relation("refundIssue")

  @@unique([id, orderId])
}

model RefundRequest {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  issueId       String      @unique @db.Uuid
  requestedBy   String      @db.Uuid
  status        String      @default("pending")
  approvedBy    String?     @db.Uuid
  resolvedBy    String?     @db.Uuid
  returnOutcome String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  approvedAt    DateTime?   @db.Timestamptz(6)
  refundIssue   IssueRecord @relation("refundIssue", fields: [issueId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  refundBuyer   Order       @relation("refundBuyer", fields: [orderId, requestedBy], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  refundSeller  Order?      @relation("refundSeller", fields: [orderId, approvedBy], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  refundResolver Account?   @relation("refundResolver", fields: [resolvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model SettlementRecord {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @db.Uuid
  mode               String        @default("simulated")
  operation          String
  amount             Decimal       @db.Decimal(38, 18)
  currency           String        @db.VarChar(12)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  settlementSnapshot OrderSnapshot @relation("settlementSnapshot", fields: [orderId, amount, currency], references: [orderId, priceAmount, currency], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, operation])
}

model SellerReview {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @unique @db.Uuid
  buyerId      String   @db.Uuid
  sellerId     String   @db.Uuid
  rating       Int      @db.SmallInt
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  orderBuyer   Order    @relation(fields: [orderId, buyerId], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  reviewBuyer  Account  @relation("reviewBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewSeller Account  @relation("reviewSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sellerId, createdAt])
  @@unique([orderId, buyerId])
}

model OrderEvent {
  note       String?
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  actorId    String?  @db.Uuid
  operation  String
  fromState  String?
  toState    String
  requestId  String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  eventOrder Order    @relation("eventOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventActor Account? @relation("eventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, createdAt, id])
}

model IdempotencyRecord {
  actorId          String   @db.Uuid
  operation        String
  key              String   @db.VarChar(100)
  requestHash      String   @db.Char(64)
  resourceId       String?  @db.Uuid
  resultCode       String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  idempotencyActor Account  @relation("idempotencyActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  idempotencyOrder Order?   @relation("idempotencyOrder", fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([actorId, operation, key])
}

model ListingReviewEvent {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  kind      String?
  reason    String
  evidence  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  actor     Account? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt, id])
}


// Business projections only. The authoritative wallet security ledger is migrated
// separately and must not be restored with this schema.
model WalletIdentity {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  chainId Int
  address String? @db.VarChar(42)
  bindingVersion Int @default(0)
  securityRevision BigInt @default(0)
  lastOperationId String? @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, chainId])
  @@unique([chainId, address])
}

model WalletClaim {
  chainId Int
  address String @db.VarChar(42)
  accountId String @db.Uuid
  claimedAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([chainId, address])
  @@index([accountId])
}

model WalletSecurityOperation {
  id String @id @db.Uuid
  accountId String @db.Uuid
  chainId Int
  operation String @db.VarChar(32)
  revision BigInt
  requestHash String @db.Char(64)
  result Json
  appliedAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, chainId, revision])
}

model WalletIdentityEvent {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  chainId Int
  operationId String @unique @db.Uuid
  operation String @db.VarChar(32)
  previousAddress String? @db.VarChar(42)
  currentAddress String? @db.VarChar(42)
  bindingVersion Int
  revision BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, createdAt])
}

model WalletChallenge {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  chainId Int
  kind String @db.VarChar(24)
  purpose String @db.VarChar(32)
  wallet String? @db.VarChar(42)
  bindingVersion Int
  recoveryEpoch String @db.Uuid
  sessionHash String @db.Char(64)
  requestHash String @unique @db.Char(64)
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  invalidatedAt DateTime? @db.Timestamptz(6)
  result Json?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, purpose, expiresAt])
}

model SellerPayoutConfirmation {
  testnetOrders TestnetOrderSnapshot[]
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  chainId Int
  wallet String @db.VarChar(42)
  escrow String @db.VarChar(42)
  bindingVersion Int
  challengeId String @unique @db.Uuid
  statement Json
  signature String @db.VarChar(132)
  confirmedAt DateTime @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, chainId, revokedAt])
  @@unique([id, accountId, chainId, wallet, escrow, bindingVersion], map: "SellerPayoutConfirmation_terms_key")
}

model ListingTestnetPrice {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  listingVersion Int
  chainId Int
  token String @db.VarChar(42)
  escrow String @db.VarChar(42)
  amountAtoms String @db.VarChar(78)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orders TestnetOrderSnapshot[]

  @@unique([listingId, listingVersion])
  @@unique([id, listingId, listingVersion, chainId, token, escrow, amountAtoms], map: "ListingTestnetPrice_terms_key")
}

model TestnetOrderSnapshot {
  orderId String @id @db.Uuid
  listingId String @db.Uuid
  sellerId String @db.Uuid
  listingVersion Int
  priceId String @db.Uuid
  chainId Int
  token String @db.VarChar(42)
  escrow String @db.VarChar(42)
  amountAtoms String @db.VarChar(78)
  sellerWallet String @db.VarChar(42)
  sellerBindingVersion Int
  payoutConfirmationId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  order Order @relation(fields: [orderId, listingId, sellerId], references: [id, listingId, sellerId], onDelete: Restrict, onUpdate: Restrict)
  snapshot OrderSnapshot @relation(fields: [orderId, listingVersion], references: [orderId, listingVersion], onDelete: Restrict, onUpdate: Restrict)
  price ListingTestnetPrice @relation(fields: [priceId, listingId, listingVersion, chainId, token, escrow, amountAtoms], references: [id, listingId, listingVersion, chainId, token, escrow, amountAtoms], onDelete: Restrict, onUpdate: Restrict, map: "TestnetOrderSnapshot_price_terms_fkey")
  payout SellerPayoutConfirmation @relation(fields: [payoutConfirmationId, sellerId, chainId, sellerWallet, escrow, sellerBindingVersion], references: [id, accountId, chainId, wallet, escrow, bindingVersion], onDelete: Restrict, onUpdate: Restrict, map: "TestnetOrderSnapshot_payout_terms_fkey")

  @@unique([orderId, listingVersion])
  @@unique([orderId, listingId, sellerId], map: "TestnetOrderSnapshot_order_terms_key")
  @@index([sellerId, createdAt])
}
